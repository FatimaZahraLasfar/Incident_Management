            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Benali\",\n  \"email\": \"ahmed.demo@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 ou 409 si déjà créé',()=>pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
