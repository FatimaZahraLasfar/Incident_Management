    {
      "name": "Tests de sécurité (section 25)",
      "item": [
        {
          "name": "S1. API protégée sans JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
                  "pm.test('message',()=>pm.expect(pm.response.json().message).to.eql(\"Authentification requise\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "S2. JWT invalide → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{badToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
                  "pm.test('message',()=>pm.expect(pm.response.json().message).to.eql(\"Token invalide\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "S3. JWT expiré → 401 (mettre un token expiré dans la variable expiredToken, ex. JWT_ACCESS_MINUTES=1 puis attendre)",
