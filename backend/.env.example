# Variables d'environnement du backend (Spring ne lit pas ce fichier tout seul :
# exportez-les dans votre terminal ou configurez-les dans votre IDE).
# Copier ce fichier en .env et remplacer les valeurs. Ne jamais committer .env.

# Secret HMAC du JWT : au moins 32 caractères, aléatoire.
# Exemple de génération : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_with_at_least_32_random_characters
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7

# Origines autorisées par CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Création des comptes de test au démarrage (true/false)
SEED_ENABLED=true

# Uniquement avec le profil mysql (SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/incidents_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
